<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Só para subir o relatório de diagnóstico. O app em si funciona offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Para começar a contar junto com o carro, sem ninguém abrir o app: é este
        aviso que a central manda quando termina de iniciar.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Um serviço em primeiro plano é o que impede o Android de matar a
        contagem no meio da viagem quando precisa de memória. Exigido a partir
        do Android 9; o tipo `dataSync`, a partir do 14.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--
        A notificação do serviço. Na central (Android 9) é concedida na
        instalação; a declaração existe para centrais mais novas.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Para o app se atualizar sozinho pela tela de configuração, sem passar
        pela loja. Quem instala de fato é o sistema, e ele continua pedindo a
        confirmação de sempre; isto só permite chamá-lo.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        Sem isto, a partir do Android 11 o app não enxerga que o HavalShisuku
        existe, e diria "não instalado" numa central onde ele está rodando.
    -->
    <queries>
        <package android:name="br.com.redesurftank.havalshisuku" />
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HavalTrip">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"
            android:theme="@style/Theme.HavalTrip">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ServicoDeBordo"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".AoLigarOCarro"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            É por este provider que o Shizuku entrega ao app a linha direta com
            os serviços internos da central. Sem ele declarado, o pedido de
            permissão nem chega a aparecer.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            Como o APK baixado chega ao instalador do Android quando a sessão
            do PackageInstaller é recusada pela ROM da central: um arquivo do
            nosso cache não pode ser lido por outro app sem esta ponte.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
